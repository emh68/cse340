<!-- Error Page -->
<div class="error-container">
    <!-- 404 Image -->
    <img src="/images/site/404-error-car.jpg" alt="Oops! 404 Page Not Found" class="error-image">

    <div class="error-overlay">
        <h1>
            <%= title %>
        </h1>
        <p class="error-message">
            <%= message %>
        </p>
        <a href="/" class="error-home-button">Home</a>
    </div>
</div>