<!-- views/inventory/add-inventory.ejs -->

<h1>
    <%= title %>
</h1>

<!-- Flash messages -->
<%- messages() %>

    <% if (errors) { %>
        <ul class="notice">
            <% errors.array().forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>

            <form id="updateForm" action="/inv/update" method="post" class="inventory-form">
                <!-- Classification Dropdown -->
                <label for="classification_id">Classification</label>
                <%- classificationList %>

                    <!-- Make -->
                    <label for="inv_make">Make</label>
                    <input type="text" id="inv_make" name="inv_make" required pattern="[A-Za-z ]+" minlength="3"
                        placeholder="Min of 3 characters" title="Only letters, numbers, and spaces allowed"
                        value="<%= locals.inv_make || '' %>">

                    <!-- Model -->
                    <label for="inv_model">Model</label>
                    <input type="text" id="inv_model" name="inv_model" required pattern="[A-Za-z0-9 ]+" minlength="3"
                        placeholder="Min of 3 characters" title="Only letters, numbers, and spaces allowed"
                        value="<%= locals.inv_model || '' %>">

                    <!-- Year -->
                    <label for="inv_year">Year</label>
                    <input type="text" id="inv_year" name="inv_year" required pattern="\d{4}" placeholder="4-digit year"
                        title="Enter a 4-digit year" value="<%= locals.inv_year || '' %>">

                    <!-- Description -->
                    <label for="inv_description">Description</label>
                    <textarea id="inv_description" name="inv_description" required
                        placeholder="Enter vehicle description"><%= locals.inv_description || '' %></textarea>

                    <!-- Image Path -->
                    <label for="inv_image">Image Path</label>
                    <input type="text" id="inv_image" name="inv_image" required
                        value="<%= locals.inv_image || '/images/vehicles/no-image.png' %>">

                    <!-- Thumbnail Path -->
                    <label for="inv_thumbnail">Thumbnail Path</label>
                    <input type="text" id="inv_thumbnail" name="inv_thumbnail" required
                        value="<%= locals.inv_thumbnail || '/images/vehicles/no-image-tn.png' %>">

                    <!-- Price -->
                    <label for="inv_price">Price</label>
                    <input type="text" id="inv_price" name="inv_price" required pattern="^\d+(\.\d{1,2})?$"
                        placeholder="Decimal or integer" title="Enter a valid price"
                        value="<%= locals.inv_price || '' %>">

                    <!-- Miles -->
                    <label for="inv_miles">Miles</label>
                    <input type="text" id="inv_miles" name="inv_miles" required pattern="^\d+$"
                        placeholder="Digits only" title="Only digits allowed" value="<%= locals.inv_miles || '' %>">

                    <!-- Color -->
                    <label for="inv_color">Color</label>
                    <input type="text" id="inv_color" name="inv_color" required pattern="[A-Za-z]+"
                        title="Only letters no spaces allowed" value="<%= locals.inv_color || '' %>">

                    <button type="submit" disabled>Update Vehicle</button>
                    <input type="hidden" name="inv_id" <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
                        <% } %>>
            </form>
            <script src="/js/script.js"></script>
            <script src="/js/inv-update.js"></script>