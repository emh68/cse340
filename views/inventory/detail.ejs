<div id="vehicle-detail-view">
    <%- detailHTML %>
</div>

<section class="reviews">
    <h2>Customer Reviews</h2>

    <% if (errors && errors.length> 0) { %>
        <ul class="error-list">
            <% errors.forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>

            <%- include('../review/vehicle-reviews', { reviews: reviews, accountData: accountData, inv_id: inv_id,
                errors: errors, reviewText: typeof reviewText !=='undefined' ? reviewText : '' }) %>

</section>