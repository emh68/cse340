<% if (!reviews || reviews.length===0) { %>
    <p>Be the first to write a review.</p>
    <% } else { %>
        <% reviews.forEach(function(r) { %>
            <div class="review-item">
                <div class="review-screen-name">
                    <strong>
                        <%= r.review_screen_name %>
                    </strong>
                    <span class="review-date"> written on <%= new Date(r.review_date).toLocaleString() %></span>
                </div>
                <hr>
                <div class="review-text">
                    <%= r.review_text %>
                </div>
            </div>
            <% }) %>
                <% } %>

                    <% if (!accountData) { %>
                        <p>You must <a href="/account/login">login</a> to write a review.</p>
                        <% } else { %>
                            <form action="/review/add" method="POST" class="add-review-form">
                                <label>Screen Name</label>
                                <input type="text"
                                    value="<%= (accountData.account_firstname ? accountData.account_firstname.charAt(0) : '') + (accountData.account_lastname || '') %>"
                                    readonly>
                                <label for="review_text">Review</label>
                                <textarea name="review_text" id="review_text" rows="6" required></textarea>
                                <input type="hidden" name="inv_id" value="<%= inv_id %>">
                                <input type="hidden" name="account_id" value="<%= accountData.account_id %>">
                                <button type="submit">Submit Review</button>
                            </form>
                            <script src="/js/script.js"></script>
                            <% } %>