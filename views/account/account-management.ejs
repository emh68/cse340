<h1>
    <%= title %>
</h1>

<!-- Greeting -->
<h2>Welcome <%= accountData.account_firstname %>
</h2>

<!-- Display flash messages -->
<%- messages %>

    <!-- Update Account (all users) -->
    <p>
        <a href="/account/update/<%= accountData.account_id %>">Edit Account Information</a>
    </p>

    <!-- Inventory Management (only for Employee/Admin) -->
    <% if (accountData.account_type==="Employee" || accountData.account_type==="Admin" ) { %>
        <h3>Inventory Management</h3>
        <p>
            <a href="/inv">Manage Inventory</a>
        </p>
        <% } %>

            <h2>My Reviews</h2>

            <% if (userReviews && userReviews.length> 0) { %>
                <ul>
                    <% userReviews.forEach(function(r, index) { %>
                        <li>
                            <%= index + 1 %>.
                                Reviewed the <a href="/inv/detail/<%= r.inv_id %>"><%- r.inv_year %> <%- r.inv_make
                                            %><%- r.inv_model %></a> on <%= new Date(r.review_date).toLocaleDateString()
                                    %>
                                    | <a href="/review/edit/<%= r.review_id %>">Edit</a>
                                    | <a href="/review/delete/<%= r.review_id %>">Delete</a>
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p>You have not written any reviews yet.</p>
                    <% } %>