<h1>
    <%= title %>
</h1>

<!-- Display flash messages -->
<%- messages() %>


    <form action="/account/login" method="post" class="login-form">
        <label for="email">Email:</label>
        <input type="email" id="email" name="account_email" required>

        <label for="account_password">Password:</label>
        <input type="password" id="account_password" name="account_password" required
            pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
            title="At least 12 characters, 1 number, 1 uppercase, and 1 special character">
        <div class="password-requirements">Passwords must be at least 12 characters long and contain at least 1 number,
            1 capital letter, and 1 special character. </div>

        <button type="submit">Login</button>
        <p class="register-link">No account?
            <a href="/account/register">Sign-up</a>
        </p>
    </form>