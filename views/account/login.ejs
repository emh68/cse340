<h1>
    <%= title %>
</h1>

<!-- Display flash messages -->
<%- messages() %>
    <% if (errors) { %>
        <ul class="notice">
            <% errors.array().forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>

            <form action="/account/login" method="post" class="login-form">
                <label for="email">Email</label>
                <input type="email" id="email" name="account_email" required value="<%= locals.account_email %>">

                <label for="account_password">Password</label>
                <div class="password-wrapper">
                    <input type="password" id="account_password" name="account_password" required
                        pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
                        title="At least 12 characters, 1 number, 1 uppercase, and 1 special character">
                    <button type="button" id="pswdBtn" class="toggle-password">Show</button>
                </div>
                <div class="password-requirements">Passwords must be at least 12 characters long and contain at least 1
                    number,
                    1 capital letter, and 1 special character. </div>
                <button type="submit">Login</button>
                <p class="register-link">No account?
                    <a href="/account/register">Sign-up</a>
                </p>
            </form>
            <script src=/js/toggle-password.js></script>